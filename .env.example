# --- Core: Postgres local_db ONLY ---
# Local Postgres database "local_db" (socket auth, no password on this machine).
DATABASE_URL=postgresql+psycopg2://nipinmishra@/local_db?host=/tmp
TABLE_PREFIX=dg_
# TCP alternative (e.g. other user/host or password auth):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/local_db

# --- LLM ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_SUMMARIZER=false
# Allows the documented, limited local templates when no API key is present.
# Keep false in production if you require generic LLM-backed Text-to-SQL.
ALLOW_DETERMINISTIC_FALLBACK=true

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-genie-text2sql

# --- Query guardrails ---
QUERY_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=3000
MAX_ROWS=500
MAX_REPAIR_RETRIES=2
# Optional PostgreSQL EXPLAIN total-cost ceiling; 0 disables it.
MAX_QUERY_COST=0
ALLOW_SQL_PREVIEW=true

# --- App ---
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# --- API access (enable in production) ---
# AUTH_ENABLED=true
# API_KEYS=replace-with-long-analyst-secret:analyst,replace-with-long-admin-secret:admin
# Admin-only reviewed mutations (disabled by default). A proposal must be
# previewed, inspected by a human, then confirmed with confirmation="APPLY".
# ENABLE_MUTATIONS=true
# MUTATION_APPROVAL_TTL_SECONDS=300
# Browser keys are appropriate only for internal demos; public apps should use
# a server-side proxy or SSO gateway instead.
